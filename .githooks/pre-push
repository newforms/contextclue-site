#!/bin/bash
# Checks every file in every commit about to be pushed, not only the last one: a file added in one
# commit and deleted in the next is still in history (scripts/guard-paths.sh says why).
set -u
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then range=$(git rev-list "$local_sha" --not --remotes); else range=$(git rev-list "$remote_sha..$local_sha"); fi
  for commit in $range; do
    git diff-tree --no-commit-id --name-only -r -z --root --diff-filter=ACMR "$commit" | while IFS= read -r -d '' path; do
      printf '%s\t%s\n' "$path" "$(git cat-file -s "$commit:$path")"
    done
  done | "$root/scripts/guard-paths.sh" || status=1
done
exit $status
